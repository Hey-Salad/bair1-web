# AWS DynamoDB (on-demand Bair1 storage)
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Sensor ingestion API key (must match firmware + relay config)
SENSOR_API_KEY=generate-a-random-hex-string

# Blues Notehub HTTP Route (server-only)
NOTEHUB_ROUTE_SECRET=generate-a-separate-random-secret
NOTEHUB_DEVICE_ID_SALT=generate-a-stable-random-salt
NOTEHUB_PRODUCT_UID=your-notehub-product-uid
NOTEHUB_OWNER_ID=optional-auth0-user-id
NOTEHUB_ORG_ID=default

# Auth0 (public SPA credentials)
NEXT_PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=your-client-id

# Mapbox (public token)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
